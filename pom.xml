<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.damonsea</groupId>
    <artifactId>rat-man</artifactId>
    <version>1.1.0</version>
    <name>Rat-Man</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jinput.version>2.0.10</jinput.version>
        <main.class>ratman.RatMan</main.class>
        <exec.mainClass>${main.class}</exec.mainClass>
        <natives.dir>${project.build.directory}/natives</natives.dir>
    </properties>

    <dependencies>
        <!-- Gamepad / Xbox controller support -->
        <dependency>
            <groupId>net.java.jinput</groupId>
            <artifactId>jinput</artifactId>
            <version>${jinput.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- target/rat-man.jar (no version in the name, so the app packaging scripts can find it) -->
        <finalName>rat-man</finalName>
        <plugins>
            <!-- Unpack JInput's native libraries (Windows/macOS/Linux) into target/natives
                 instead of committing .dll files to the repo. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>unpack-jinput-natives</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>net.java.jinput</groupId>
                                    <artifactId>jinput</artifactId>
                                    <version>${jinput.version}</version>
                                    <classifier>natives-all</classifier>
                                    <type>jar</type>
                                    <outputDirectory>${natives.dir}</outputDirectory>
                                    <excludes>META-INF/**</excludes>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <!-- Copy runtime libraries (JInput) to target/lib for building the desktop apps -->
                    <execution>
                        <id>copy-libs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- mvn compile exec:java  → runs the game -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <systemProperties>
                        <systemProperty>
                            <key>net.java.games.input.librarypath</key>
                            <value>${natives.dir}</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>

            <!-- mvn package → target/rat-man.jar with Main-Class set -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

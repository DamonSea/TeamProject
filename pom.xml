<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.damonsea</groupId>
    <artifactId>rat-man</artifactId>
    <version>1.1.0</version>
    <name>Rat-Man</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jamepad.version>2.30.0.0</jamepad.version>
        <main.class>ratman.RatMan</main.class>
        <exec.mainClass>${main.class}</exec.mainClass>
    </properties>

    <dependencies>
        <!-- Game controllers (PS5, PS4, Xbox, Switch Pro, ...) via SDL; native code for
             Windows, macOS (Intel + Apple Silicon) and Linux is bundled in the jar -->
        <dependency>
            <groupId>com.badlogicgames.jamepad</groupId>
            <artifactId>jamepad</artifactId>
            <version>${jamepad.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- target/rat-man.jar (no version in the name, so the app packaging scripts can find it) -->
        <finalName>rat-man</finalName>
        <plugins>
            <!-- Copy runtime libraries (Jamepad and its loader) to target/lib for building the desktop apps -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-libs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- mvn compile exec:java  → runs the game -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>

            <!-- mvn package → target/rat-man.jar with Main-Class set -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
